# Copy these variable NAMES into GitLab:
# Settings -> CI/CD -> Variables
# Scope each variable to the matching environment (certification / production).
# Mark secrets as Masked and Protected.
#
# --- Azure deploy credentials (all environments) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
#
# --- Poll Processor Function App ---
POLLPROCESSOR_FUNCTION_APP_NAME=
#
# --- Tab Load Function App ---
TABLOAD_FUNCTION_APP_NAME=
#
# --- IfrFunction (DEV pipeline: .gitlab-ci-ifr-dev.yml) ---
# Full required list: ci/gitlab-variables-ifr-dev.env.example
IFR_FUNCTION_APP_NAME=
#
# --- Runtime environment ---
AZURE_FUNCTIONS_ENVIRONMENT=Certification
APP_ENVIRONMENT_CODE=Cert
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated
#
# --- Key Vault (recommended: secrets live in vault, not GitLab) ---
KEY_VAULT_URI=https://your-vault.vault.azure.net/
KEY_VAULT_MANAGED_IDENTITY_CLIENT_ID=
#
# --- AppResources (use only if NOT using Key Vault for these secrets) ---
AZURE_WEBJOBS_STORAGE=
APPRESOURCES_SQL_CONNECTION_STRING=
APPRESOURCES_AZURE_WEBJOBS_STORAGE=
APPRESOURCES_STORAGE_ACCOUNT_NAME=
APPRESOURCES_FILE_SHARE_NAME=
APPRESOURCES_DATA_FACTORY_SUBSCRIPTION_ID=
APPRESOURCES_DATA_FACTORY_RESOURCE_GROUP_NAME=
APPRESOURCES_DATA_FACTORY_NAME=
APPRESOURCES_ADF_MANAGEMENT_API_VERSION=2018-06-01
APPRESOURCES_ADF_TRIGGER_URL=
APPRESOURCES_SQL_AGENT_VALIDATION_CONNECTION_STRING=
APPRESOURCES_ADF_VALIDATION_CONNECTION_STRING=
APPRESOURCES_APP_ENVIRONMENT_CODE=Cert
#
# --- TabLoad paths ---
APPRESOURCES_FTP_SHARE_PATH=ftp
APPRESOURCES_DDL_SHARE_PATH=ddl
APPRESOURCES_BACKUP_SHARE_PATH=backup/tabload
APPRESOURCES_UNZIP_SHARE_PATH=unzip
#
# --- Poll notifications (PollProcessor only) ---
SENDGRID_API_KEY=
POLL_NOTIFY_EMAIL_FROM=
POLL_NOTIFY_EMAIL_TO=
