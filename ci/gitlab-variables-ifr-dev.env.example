# =============================================================================
# IfrFunction DEV — GitLab CI/CD Variables (MANDATORY)
# =============================================================================
# Copy these NAMES into GitLab:
#   Settings → CI/CD → Variables
# Scope each variable to environment:  dev
# Mark secrets as:  Masked  +  Protected
#
# Pipeline file:  .gitlab-ci-ifr-dev.yml
# Deploy fails if required variables below are empty.
# =============================================================================

# -----------------------------------------------------------------------------
# MANDATORY — Azure service principal (template ARM_*  OR  this repo AZURE_*)
# -----------------------------------------------------------------------------
ARM_TENANT_ID=
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_SUBSCRIPTION_ID=
# Aliases accepted by scripts if ARM_* is not used:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# -----------------------------------------------------------------------------
# MANDATORY — Function App target
# -----------------------------------------------------------------------------
IFR_FUNCTION_APP_NAME=
AZURE_RESOURCE_GROUP_NAME=

# -----------------------------------------------------------------------------
# MANDATORY — Build (corporate template)
# -----------------------------------------------------------------------------
NUGET_AUTH=
# File-type variable pointing at nuget.config with Artifactory credentials.
# Provided by platform team / GitLab file variable.

# Optional build (defaults exist in YAML):
# RUNNER_TAG=cicd-aks-dev
# COMPILER_VERSION=mtb-ubi8-dotnet80:0.3.70
# BAR_REGISTRY=artifactory-saas.mtb.com
# APPLY_MIGRATE_DB_IMAGE=mtb-ubi8-az-dotnet60-sdk:latest

# -----------------------------------------------------------------------------
# MANDATORY — Runtime
# -----------------------------------------------------------------------------
AZURE_FUNCTIONS_ENVIRONMENT=Development
APP_ENVIRONMENT_CODE=Dev
APPRESOURCES_APP_ENVIRONMENT_CODE=Dev
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated

# -----------------------------------------------------------------------------
# MANDATORY secrets — pick ONE approach
# -----------------------------------------------------------------------------
# Approach A (recommended): Key Vault
KEY_VAULT_URI=https://your-dev-vault.vault.azure.net/
KEY_VAULT_MANAGED_IDENTITY_CLIENT_ID=

# Approach B: set these in GitLab if Key Vault is not used
AZURE_WEBJOBS_STORAGE=
APPRESOURCES_AZURE_WEBJOBS_STORAGE=
APPRESOURCES_IFR_SQL_CONNECTION_STRING=
APPRESOURCES_FILE_SHARE_NAME=

# -----------------------------------------------------------------------------
# OPTIONAL — APT / SPECTR / APT-to-PDF (defaults applied if empty)
# -----------------------------------------------------------------------------
APPRESOURCES_APT_INPUT_SHARE_PATH=ifr/apt/inbound
APPRESOURCES_SPECTR_INPUT_SHARE_PATH=ifr/spectr/inbound
APPRESOURCES_ARCHIVE_SHARE_PATH=ifr/archive
APPRESOURCES_APT_PROCESSED_SHARE_PATH=ifr/apt/processed
APPRESOURCES_SPECTR_PROCESSED_SHARE_PATH=ifr/spectr/processed
APPRESOURCES_LOGO_SHARE_PATH=ifr/assets/logo.png
APPRESOURCES_BLOB_CONTAINER_NAME=ifr

APPRESOURCES_APT_TO_PDF_ENABLED=true
APPRESOURCES_APT_TO_PDF_INPUT_CONTAINER=input
APPRESOURCES_APT_TO_PDF_PROCESSING_CONTAINER=processing
APPRESOURCES_APT_TO_PDF_OUTPUT_CONTAINER=output
APPRESOURCES_APT_TO_PDF_ARCHIVE_CONTAINER=archive
APPRESOURCES_APT_TO_PDF_FAILED_CONTAINER=failed
APPRESOURCES_APT_TO_PDF_LOGS_CONTAINER=logs
APPRESOURCES_APT_TO_PDF_USE_DATABASE_SCHEDULER=true
APPRESOURCES_APT_TO_PDF_SCHEDULER_CRON=0 */5 * * * *
APPRESOURCES_APT_TO_PDF_MAX_RETRIES=3
APPRESOURCES_LEGACY_APT_PDF_EXE_PATH=
APPRESOURCES_ENSURE_METADATA_TABLES=true

APPRESOURCES_APT_SPECTR_POLLING_ENABLED=false
APPRESOURCES_APT_APPLY_TRANSFORMATIONS=false
APPRESOURCES_SPECTR_APPLY_TRANSFORMATIONS=true
APPRESOURCES_APT_SPECTR_MAX_RETRY_ATTEMPTS=3
